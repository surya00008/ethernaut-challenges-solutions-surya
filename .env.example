# Sepolia RPC URL (get from Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Your private key (use cast wallet import instead for security)
PRIVATE_KEY=your_private_key_here

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Your wallet address
MY_ADDRESS=0xYourWalletAddress

# Ethernaut main contract
ETHERNAUT_CONTRACT=0xa3e7317E591D5A0F1c605be1b3aC4D2ae56104d6
